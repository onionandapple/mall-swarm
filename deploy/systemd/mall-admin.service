[Unit]
Description=mall-admin service
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=mall
WorkingDirectory=/opt/mall-swarm
ExecStart=/usr/bin/java -Xms512m -Xmx512m -XX:MaxMetaspaceSize=192m -Duser.timezone=Asia/Shanghai -jar /opt/mall-swarm/mall-admin.jar --server.address=127.0.0.1 --spring.cloud.nacos.discovery.ip=127.0.0.1 --spring.cloud.nacos.config.refresh-enabled=false
Restart=always
RestartSec=10
StandardOutput=append:/opt/mall-swarm/logs/mall-admin.log
StandardError=append:/opt/mall-swarm/logs/mall-admin.log

[Install]
WantedBy=multi-user.target
