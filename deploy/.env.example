# 复制为 /opt/mall-swarm/.env 并修改实际值；不要提交真实密码到仓库
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PASSWORD=change_me
REDIS_PASSWORD=change_me
RABBITMQ_PASSWORD=change_me
MINIO_PASSWORD=change_me
# 浏览器访问 MinIO 图片使用的地址（当前服务器 Tailscale 地址）
MINIO_PUBLIC_ENDPOINT=http://100.125.54.127:9000
# Nacos 3 启动校验需要；Nacos 2.5.1 也保留兼容。可用 openssl rand -base64 32 生成
NACOS_AUTH_TOKEN=change_me_base64_32_bytes
NACOS_AUTH_IDENTITY_KEY=nacos
NACOS_AUTH_IDENTITY_VALUE=nacos
